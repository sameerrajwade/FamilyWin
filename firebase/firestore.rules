rules_version = '2';
/**
 * Firestore Security Rules for FamilyWin
 * ─────────────────────────────────────────────────────────────────────────────
 * Equivalent to the Supabase Row-Level Security policies.
 *
 * Structure:
 *   /users/{uid}                                  ← uid → { familyId, memberId }
 *   /families/{familyId}                          ← family document
 *   /families/{familyId}/members/{memberId}
 *   /families/{familyId}/tasks/{taskId}
 *   /families/{familyId}/completions/{id}
 *   /families/{familyId}/transactions/{id}
 *   /families/{familyId}/rewards/{rewardId}
 *   /families/{familyId}/redemptions/{id}
 *   /families/{familyId}/weeklyScores/{weekId}
 *   /families/{familyId}/notificationConfigs/{memberId}
 * ─────────────────────────────────────────────────────────────────────────────
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    /** Get the user lookup doc — cached per rule evaluation */
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /** The familyId linked to the current user */
    function myFamilyId() {
      return userDoc().familyId;
    }

    /** True if the current user belongs to the given family */
    function isFamilyMember(familyId) {
      return isSignedIn() && myFamilyId() == familyId;
    }

    /** True if the current user is a parent or admin_parent in the given family */
    function isParent(familyId) {
      let memberId = userDoc().memberId;
      let memberData = get(
        /databases/$(database)/documents/families/$(familyId)/members/$(memberId)
      ).data;
      return memberData.role == 'parent' || memberData.role == 'admin_parent';
    }

    /** True if the current user is the owner of this member doc */
    function isOwnerMember(familyId, memberId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(memberId))
             .data.userId == request.auth.uid;
    }

    // ── /users/{uid} ─────────────────────────────────────────────────────────
    // Each user can only read/write their own lookup doc.

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── /families/{familyId} ─────────────────────────────────────────────────

    match /families/{familyId} {
      // Any signed-in family member can read family doc
      allow read: if isFamilyMember(familyId);
      // Anyone signed in can create a family (for onboarding)
      allow create: if isSignedIn();
      // Only admin_parent can update family settings
      allow update: if isFamilyMember(familyId) && isParent(familyId);
      allow delete: if false;

      // ── Members subcollection ─────────────────────────────────────────────
      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        // New members can join (create their own doc)
        allow create: if isSignedIn();
        // A parent may update any member (incl. promoting/demoting roles). A
        // member may update their OWN doc (name, avatar, etc.) but NOT change
        // their own `role` — otherwise a child could self-promote to parent and
        // bypass the parent-controlled join model. Role changes are parent-only.
        allow update: if isParent(familyId)
          || (isOwnerMember(familyId, memberId)
              && request.resource.data.role == resource.data.role);
        allow delete: if false;
      }

      // ── Tasks subcollection ───────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow create, update: if isFamilyMember(familyId) && isParent(familyId);
        allow delete: if isFamilyMember(familyId) && isParent(familyId);
      }

      // ── Completions subcollection ─────────────────────────────────────────
      match /completions/{completionId} {
        allow read: if isFamilyMember(familyId);
        // Who may create a completion, and in what state:
        //   • A PARENT may create any completion (their own instant award, or a
        //     managed kid's claim — the client stamps those pending for Kid Mode,
        //     but a parent is trusted to award directly).
        //   • A NON-PARENT (child, whether self-account or managed) may create
        //     only: a pending AWARD (status == 'pending', so it waits for a
        //     parent OK — this is the rules-level backstop for the C3 "every kid
        //     claim needs approval" rule), OR a negative PENALTY
        //     (wasAutoFailed == true — a miss/auto-fail marker only ever DEDUCTS,
        //     so a kid can never self-grant points through it). An approved or
        //     status-less award from a kid is rejected here.
        allow create: if isFamilyMember(familyId)
          && (isParent(familyId)
              || request.resource.data.status == 'pending'
              || request.resource.data.wasAutoFailed == true);
        // Phase 4.3 task verification: a PARENT may approve/reject a completion,
        // changing ONLY the status (+ approver stamp). Everything else stays
        // immutable, and a child can never flip their own pending completion to
        // 'approved' — so points still can't be self-granted. Points settle via
        // the onCompletionUpdated Cloud Function, not the client.
        allow update: if isFamilyMember(familyId) && isParent(familyId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt'])
          && request.resource.data.status in ['approved', 'rejected'];
        // A member can undo (delete) their own completion; parents can also
        // undo on behalf of managed children. The app additionally enforces
        // the "same calendar day" rule client-side.
        allow delete: if isFamilyMember(familyId)
          && (resource.data.memberId == userDoc().memberId || isParent(familyId));
      }

      // ── Transactions subcollection ────────────────────────────────────────
      // Phase 1.8: clients may NOT write task-sourced points — the Cloud
      // Function (admin SDK, bypasses rules) is the sole writer of source:'task'
      // transactions. Parents may still log discipline/manual/bonus adjustments,
      // and any member may create the redemption spend. This closes the
      // point-forging hole (a modified client can no longer grant task points).
      // Only PARENTS write transactions from a client, and only these sources:
      // discipline/manual/bonus adjustments and the redemption spend (written on
      // parent approval). Task points are Cloud-Function-only. Children (whether
      // self-account or parent-managed) never write transactions directly, so a
      // modified client can't forge points OR inflate a spendable balance.
      match /transactions/{transactionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isParent(familyId)
          && request.resource.data.source in ['discipline', 'manual', 'bonus', 'redemption'];
        allow update, delete: if false; // immutable audit logs
      }

      // ── Rewards subcollection ─────────────────────────────────────────────
      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyMember(familyId) && isParent(familyId);
      }

      // ── Penalties subcollection ───────────────────────────────────────────
      // Parent-defined penalty presets (the customizable "negative rewards"
      // list). Mirrors rewards: any member reads; only parents manage.
      match /penalties/{penaltyId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyMember(familyId) && isParent(familyId);
      }

      // ── Bounties subcollection (Phase E4) ─────────────────────────────────
      // A parent posts "first to wash the car +100". Parents run the bounty
      // (post, approve, reject, award, delete). A NON-PARENT may only:
      //   • CLAIM an open bounty for THEMSELVES (open → claimed, claimedBy = me)
      //   • WITHDRAW their own claim (claimed-by-me → open, claimedBy = null)
      // touching nothing but status/claimedBy/claimedAt. They can never mark a
      // bounty done; the points are a parent-written source:'bonus' transaction.
      match /bounties/{bountyId} {
        allow read: if isFamilyMember(familyId);
        allow create, delete: if isFamilyMember(familyId) && isParent(familyId);
        allow update: if isFamilyMember(familyId) && (
          isParent(familyId)
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'claimedBy', 'claimedAt'])
              && (
                (resource.data.status == 'open'
                  && request.resource.data.status == 'claimed'
                  && request.resource.data.claimedBy == userDoc().memberId)
                || (resource.data.status == 'claimed'
                  && resource.data.claimedBy == userDoc().memberId
                  && request.resource.data.status == 'open'
                  && request.resource.data.claimedBy == null)
              ))
        );
      }

      // ── Redemptions subcollection ─────────────────────────────────────────
      match /redemptions/{redemptionId} {
        allow read: if isFamilyMember(familyId);
        // Any family member can request a redemption
        allow create: if isFamilyMember(familyId);
        // Only parents can approve/reject
        allow update: if isFamilyMember(familyId) && isParent(familyId);
        allow delete: if false;
      }

      // ── Weekly Scores subcollection ───────────────────────────────────────
      // Written only by Cloud Functions (admin SDK bypasses rules)
      match /weeklyScores/{weekId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false; // Cloud Function only
      }

      // ── Notification Configs ──────────────────────────────────────────────
      match /notificationConfigs/{memberId} {
        allow read, write: if isOwnerMember(familyId, memberId) || isParent(familyId);
      }
    }
  }
}
