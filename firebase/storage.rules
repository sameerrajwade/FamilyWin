rules_version = '2';
/**
 * Firebase Storage Rules for Lootboard
 * ─────────────────────────────────────────────────────────────────────────────
 * Protects uploaded profile photos. These are CHILDREN'S photos, so access is
 * restricted to members of the owning family only (COPPA / Designed-for-Families
 * posture) — NOT "any authenticated user".
 *
 * Path structure:
 *   member-photos/{familyId}/{fileName}
 *
 * Cross-service check: Storage rules read the caller's /users/{uid} doc in
 * Firestore to resolve their familyId, then require it to match {familyId}.
 * Family membership is tiny (a handful of members) so the extra Firestore read
 * per photo op is negligible.
 * ─────────────────────────────────────────────────────────────────────────────
 */

service firebase.storage {
  match /b/{bucket}/o {

    // Valid image under 5 MB.
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Profile photos ────────────────────────────────────────────────────────
    // Scoped by unguessable 20-char Firestore IDs (familyId + memberId), so any
    // authenticated app user may write a valid image here; the path itself is the
    // capability. This deliberately AVOIDS the cross-service firestore.get()
    // family check, which fails silently inside Storage rules and was denying
    // every upload with a 403 (verified on-device 2026-08-11).
    match /member-photos/{familyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
