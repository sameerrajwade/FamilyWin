rules_version = '2';
/**
 * Firebase Storage Rules for Lootboard
 * ─────────────────────────────────────────────────────────────────────────────
 * Protects uploaded profile photos. These are CHILDREN'S photos, so access is
 * restricted to members of the owning family only (COPPA / Designed-for-Families
 * posture) — NOT "any authenticated user".
 *
 * Path structure:
 *   member-photos/{familyId}/{fileName}
 *
 * Cross-service check: Storage rules read the caller's /users/{uid} doc in
 * Firestore to resolve their familyId, then require it to match {familyId}.
 * Family membership is tiny (a handful of members) so the extra Firestore read
 * per photo op is negligible.
 * ─────────────────────────────────────────────────────────────────────────────
 */

service firebase.storage {
  match /b/{bucket}/o {

    // True if the signed-in caller belongs to {familyId}, per their user doc.
    function isFamilyMember(familyId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    // ── Profile photos ────────────────────────────────────────────────────────
    match /member-photos/{familyId}/{fileName} {
      // Read/write/delete only within the caller's own family.
      allow read: if isFamilyMember(familyId);

      allow write: if isFamilyMember(familyId)
        // Max 5 MB per photo
        && request.resource.size <= 5 * 1024 * 1024
        // Must be a JPEG, PNG, or WebP image
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if isFamilyMember(familyId);
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
