{
  "name": "familywin",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:rules": "firebase emulators:exec --project demo-lootboard --only firestore \"jest --config jest.rules.config.js\"",
    "test:functions": "firebase emulators:exec --project demo-lootboard --only firestore,functions \"jest --config jest.functions.config.js\""
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.2.0",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/app-check": "^26.2.0",
    "@react-native-firebase/auth": "^26.2.0",
    "@react-native-firebase/crashlytics": "^26.2.0",
    "@react-native-firebase/firestore": "^26.2.0",
    "@react-native-firebase/functions": "^26.2.0",
    "@react-native-firebase/messaging": "^26.2.0",
    "@react-native-firebase/storage": "^26.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/native": "^6.1.17",
    "date-fns": "^3.6.0",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.3",
    "expo-background-fetch": "~57.0.9",
    "expo-build-properties": "~57.0.10",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-sharing": "~57.0.11",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.9",
    "promise": "^8.3.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "firebase": "^12.17.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.after.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 30,
        "lines": 35,
        "statements": 35
      },
      "./lib/pointsEngine.ts": {
        "branches": 90,
        "functions": 100,
        "lines": 95,
        "statements": 95
      },
      "./store/index.ts": {
        "branches": 70,
        "functions": 85,
        "lines": 88,
        "statements": 88
      }
    },
    "collectCoverageFrom": [
      "lib/**/*.{ts,tsx}",
      "store/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@react-native-firebase/.*|@react-native-google-signin/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "private": true
}
