<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) splash. The system SplashScreen API ignores
     windowBackground for the launch splash and instead composes
     windowSplashScreenBackground + windowSplashScreenAnimatedIcon. Without this,
     Android 12+ fell back to the launcher icon, so the splash showed whatever
     the launcher had cached (the old trophy). Point it explicitly at the chest. -->
<resources>
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowSplashScreenBackground">@color/iconBackground</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="android:windowBackground">@drawable/splashscreen</item>
  </style>
</resources>
